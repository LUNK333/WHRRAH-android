<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SAF (ACTION_OPEN_DOCUMENT / ACTION_CREATE_DOCUMENT) is used for all
         telemetry/video/layout file access - no raw filesystem permissions
         needed for that. READ_MEDIA_VIDEO covers gallery-style video pickers
         pre-SAF on some launchers; harmless to declare either way. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WHRRAH">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.WHRRAH">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
